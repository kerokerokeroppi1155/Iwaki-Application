{
  "expo": {
    "name": "いわき暮らしマップ",
    "slug": "iwaki-life-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "jp.iwaki.lifemap",
      "supportsTablet": true
